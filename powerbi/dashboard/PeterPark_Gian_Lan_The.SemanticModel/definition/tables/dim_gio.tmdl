table dim_gio

	column gio
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: gio

	column nhan_gio
		dataType: string
		sortByColumn: gio
		summarizeBy: none
		sourceColumn: nhan_gio

	column buoi
		dataType: string
		summarizeBy: none
		sourceColumn: buoi

	partition dim_gio = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\PETTER\Desktop\python\du_an_gian_lan_the_tin_dung\powerbi\dim_gio.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"gio", Int64.Type}, {"nhan_gio", type text}, {"buoi", type text}}, "en-US"),
				    Clean = Table.ReplaceValue(Typed, "", null, Replacer.ReplaceValue, {"nhan_gio", "buoi"})
				in
				    Clean

