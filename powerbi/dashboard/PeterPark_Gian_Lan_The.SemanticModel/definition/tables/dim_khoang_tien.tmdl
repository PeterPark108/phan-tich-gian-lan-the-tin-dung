table dim_khoang_tien

	column khoang_tien_id
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: khoang_tien_id

	column khoang_tien
		dataType: string
		sortByColumn: khoang_tien_id
		summarizeBy: none
		sourceColumn: khoang_tien

	column nhom
		dataType: string
		summarizeBy: none
		sourceColumn: nhom

	partition dim_khoang_tien = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\PETTER\Desktop\python\du_an_gian_lan_the_tin_dung\powerbi\dim_khoang_tien.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"khoang_tien_id", Int64.Type}, {"khoang_tien", type text}, {"nhom", type text}}, "en-US"),
				    Clean = Table.ReplaceValue(Typed, "", null, Replacer.ReplaceValue, {"khoang_tien", "nhom"})
				in
				    Clean

