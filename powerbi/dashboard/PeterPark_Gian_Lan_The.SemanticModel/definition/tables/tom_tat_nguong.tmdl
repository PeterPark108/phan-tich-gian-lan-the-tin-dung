table tom_tat_nguong

	column nguong
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: nguong

	column so_canh_bao
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: so_canh_bao

	column bat_duoc
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: bat_duoc

	column bo_sot
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: bo_sot

	column precision
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: precision

	column recall
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: recall

	column chi_phi_xem
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: chi_phi_xem

	column tien_bo_sot
		dataType: double
		formatString: #,0.00
		summarizeBy: none
