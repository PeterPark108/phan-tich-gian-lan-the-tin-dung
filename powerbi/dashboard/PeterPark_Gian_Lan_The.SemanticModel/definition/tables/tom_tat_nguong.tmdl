	column tong_chi_phi
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: tong_chi_phi

	partition tom_tat_nguong = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\PETTER\Desktop\python\du_an_gian_lan_the_tin_dung\powerbi\tom_tat_nguong.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"nguong", type number}, {"so_canh_bao", Int64.Type}, {"bat_duoc", Int64.Type}, {"bo_sot", Int64.Type}, {"precision", type number}, {"recall", type number}, {"chi_phi_xem", type number}, {"tien_bo_sot", type number}, {"tong_chi_phi", type number}}, "en-US")
				in
				    Typed

